<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <RootNamespace>Jalalix</RootNamespace>
    <AssemblyName>JalaliX</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Authors>Hossein Maklavani</Authors>
    <Description>Jalali (Persian / Shamsi) calendar for .NET</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://jalalix.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jalalix/dotnet</RepositoryUrl>
  </PropertyGroup>
</Project>
